y({before,after:JSON.parse(await v.read('.agents/raw-manifest.json')).files['dokument.md'].sha256,findings:await lintRawImmutability(c)}));}\nelse if(mode==='reflect')console.log('reflect',JSON.stringify(await p.reflect()));\nelse if(mode==='init'){await v.write('.agents/FOREIGN.txt','PRIVATE');console.log('cli',JSON.stringify(await runCli(v.root,['init'])));}\nelse if(mode==='audit')console.log('audit',(await p.audit({scope:['wiki/Foreign.md']})).data.status);\nelse if(mode==='symlink'){const out=await fs.mkdtemp(path.resolve('.verification/tmp/out-'));await fs.symlink(out,v.path('wiki/Link'));try{await writeNote(v.root,'wiki/Link/Escape.md',{body:'escape'});console.log('write','SUCCESS')}catch(e){console.log('write',e.message)}console.log('outside',JSON.stringify(await fs.readdir(out)));}\nelse{await p.ingest({source:'raw/dokument.md',title:'Own Document'});if(mode==='ready'){await s.setFields(id,{blocked_reason:'fixture'},{actor:'operator'});await s.transition(id,'blocked',{actor:'operator'});console.log('cli',JSON.stringify(await runCli(v.root,['ready',id,'--reason','fixture'])));}else{for(const method of ['runResearch','runVerify','runChallenge'])console.log(method,JSON.stringify(await p[method](id)));\nif(mode==='retry'){const pre=(await s.get(id)).data.artifacts;process.env.AGENT_2_0_MOCK_CONSOLIDATE_TOUCH='wiki/Foreign.md';console.log('rejected',JSON.stringify(await p.runConsolidate(id)));delete process.env.AGENT_2_0_MOCK_CONSOLIDATE_TOUCH;console.log('artifacts-same',JSON.stringify(pre)===JSON.stringify((await s.get(id)).data.artifacts));await s.transition(id,'ready',{actor:'operator'});await p.runResearch(id);await p.runVerify(id);}\nif(mode==='proof'){const lock=v.path('.git/refs/tags/dokaz/TASK-101-verify.lock');await fs.mkdir(path.dirname(lock),{recursive:true});await fs.writeFile(lock,'lock');console.log('proof-failure',JSON.stringify(await p.runConsolidate(id)));const d=(await s.get(id)).data;console.log('proof-state',d.status,d.lock_owner);await fs.r